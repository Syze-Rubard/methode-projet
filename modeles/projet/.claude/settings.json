{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__.*(generate|outpaint|inpaint|motion_control|text_to|image_to).*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".claude/hooks/garde-generation-ia.ps1"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".claude/hooks/rappel-clear.ps1"],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".claude/hooks/garde-tests.ps1"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}

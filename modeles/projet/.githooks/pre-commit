#!/bin/sh
# Blocks the commit when it holds a secret (.claude/hooks/garde-secrets.ps1), when the project
# no longer follows the method (.claude/hooks/garde-methode.ps1), or when the project's checks
# fail (.claude/hooks/garde-tests.ps1).
powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/garde-secrets.ps1 || exit 1
powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/garde-methode.ps1 || exit 1
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/garde-tests.ps1 -AvantCommit
